# Copy this file to fastlane/.env and fill in the values.
# fastlane/.env is gitignored — never commit your real key id, issuer id,
# or .p8 file.

# 10-character key ID from App Store Connect -> Users and Access -> Integrations.
ASC_KEY_ID=

# UUID at the top of the same page.
ASC_ISSUER_ID=

# Absolute path to the .p8 file (downloaded once, can't be re-downloaded).
# Recommended location: ~/.appstoreconnect/AuthKey_<KEY_ID>.p8
ASC_KEY_FILEPATH=
