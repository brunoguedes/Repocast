default_platform(:ios)

require "dotenv"

# fastlane's own dotenv pass doesn't reliably pick up fastlane/.env here, and
# neither it nor dotenv expands a leading `~` — so load it explicitly. Values
# already in the environment win.
Dotenv.load(File.join(__dir__, ".env"))
ENV["ASC_KEY_FILEPATH"] = File.expand_path(ENV["ASC_KEY_FILEPATH"]) if ENV["ASC_KEY_FILEPATH"]

# ─── Helpers ────────────────────────────────────────────────────────────────

PROJECT_ROOT   = File.expand_path("..", __dir__).freeze
PROJECT_YML    = File.join(PROJECT_ROOT, "project.yml").freeze
XCODEPROJ      = "Repocast.xcodeproj".freeze
APP_SCHEME     = "Repocast".freeze
APP_IDENTIFIER = "au.com.bclgapps.Repocast".freeze
NOTES_DIR      = File.join(File.expand_path(__dir__), "release-notes").freeze

# Every uploaded build is tagged `<APP_SCHEME>-v<version>(<build>)`, so the
# tag's commit is exactly what that build contains and the next build's notes
# can be drafted from the commits since it.
def build_tag(version = current_marketing_version, build = current_build_number)
  "#{APP_SCHEME}-v#{version}(#{build})"
end

# Tester-facing "What to Test" text for a build, committed alongside the code.
def release_notes_path(version = current_marketing_version, build = current_build_number)
  File.join(NOTES_DIR, "#{version}-#{build}.txt")
end

# The most recent build tag reachable from HEAD, or nil before the first one.
def last_build_tag
  tags = sh("git", "tag", "--merged", "HEAD", "--list", "#{APP_SCHEME}-v*", log: false).split("\n")
  tags.max_by { |tag| tag[/\((\d+)\)\z/, 1].to_i }
end

# Where the previous build's commits end: its tag or, before the first tagged
# build, the last commit that changed the build number in project.yml. nil
# for the very first build — the commit that created project.yml has no
# parent and isn't a build.
def last_build_ref
  return last_build_tag if last_build_tag

  sha, parents = sh("git", "log", "-1", "--format=%h %p", "-G", "CURRENT_PROJECT_VERSION:", "HEAD", "--", PROJECT_YML, log: false).strip.split(" ", 2)
  sha.nil? || parents.to_s.empty? ? nil : sha
end

# A plain draft of the notes from the commit subjects since the last build:
# `feat:` → New, `perf:` → Improved, `fix:` → Fixed. Other conventional types
# (docs, chore, refactor, test, research…) are left out because testers can't
# see them; subjects that don't follow the convention go under Changes, to be
# rewritten or dropped.
def draft_release_notes
  range = last_build_ref ? "#{last_build_ref}..HEAD" : "HEAD"
  subjects = sh("git", "log", "--no-merges", "--format=%s", range, log: false).split("\n")
  conventional = /\A\w+(\([^)]*\))?!?:\s*/
  pick = ->(type) { subjects.grep(/\A#{type}(\([^)]*\))?!?:\s*/).map { |s| s.sub(conventional, "") } }
  sections = {
    "New" => pick.("feat"),
    "Improved" => pick.("perf"),
    "Fixed" => pick.("fix"),
    "Changes" => subjects.grep_v(conventional)
  }.reject { |_, items| items.empty? }
  return "Maintenance build — no tester-visible changes." if sections.empty?

  sections.map { |title, items| "#{title}:\n" + items.map { |i| "• #{i[0].upcase}#{i[1..]}" }.join("\n") }.join("\n\n")
end

# Polls App Store Connect until the current build number shows up for the
# current version. Returns false if it hasn't after `timeout` seconds.
def wait_for_build_on_testflight(api_key, timeout: 900)
  deadline = Time.now + timeout
  loop do
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: current_marketing_version,
      initial_build_number: 0
    )
    return true if latest.to_s == current_build_number
    return false if Time.now > deadline

    UI.message("Build #{current_build_number} not on App Store Connect yet (latest: #{latest}) — checking again in 30s")
    sleep(30)
  end
end

# Waits until App Store Connect lists the build as a build record, which is
# what setting "What to Test" needs. That lags the upload by a few minutes:
# `latest_testflight_build_number` already sees the delivery, but pilot's
# build lookup returns "No build to distribute!" until processing starts.
# Needs Spaceship's token, which `resolve_asc_api_key` sets.
def wait_for_build_record(build, timeout: 1800)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  deadline = Time.now + timeout
  loop do
    return true if Spaceship::ConnectAPI::Build.all(app_id: app.id, version: current_marketing_version, build_number: build).any?
    return false if Time.now > deadline

    UI.message("Build #{build} isn't listed for \"What to Test\" yet — checking again in 30s")
    sleep(30)
  end
end

# Waits until App Store Connect has finished processing the build, which is
# what adding it to a beta group needs — pilot's distribute path returns
# without distributing while the build is still PROCESSING. Returns false on
# timeout and fails outright if processing rejected the build.
def wait_for_build_processed(build, timeout: 3600)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  deadline = Time.now + timeout
  loop do
    record = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: current_marketing_version, build_number: build).first
    state = record&.processing_state
    return true if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
    UI.user_error!("App Store Connect marked build #{build} #{state}.") if %w[INVALID FAILED].include?(state)
    return false if Time.now > deadline

    UI.message("Build #{build} is #{state || 'not listed yet'} — checking again in 60s")
    sleep(60)
  end
end

# Read the current MARKETING_VERSION from project.yml.
def current_marketing_version
  File.read(PROJECT_YML).match(/^\s+MARKETING_VERSION:\s+"([^"]+)"/)[1]
end

# Read the current CURRENT_PROJECT_VERSION from project.yml.
def current_build_number
  File.read(PROJECT_YML).match(/^\s+CURRENT_PROJECT_VERSION:\s+"([^"]+)"/)[1]
end

# Replace MARKETING_VERSION and/or CURRENT_PROJECT_VERSION in project.yml,
# preserving everything else. Both live once, under the project-level
# settings.base, so every target picks up the rewritten values.
def write_versions(marketing: nil, build: nil)
  text = File.read(PROJECT_YML)
  if marketing
    text.sub!(/^(\s+MARKETING_VERSION:\s+)"[^"]+"/, "\\1\"#{marketing}\"")
  end
  if build
    text.sub!(/^(\s+CURRENT_PROJECT_VERSION:\s+)"[^"]+"/, "\\1\"#{build}\"")
  end
  File.write(PROJECT_YML, text)
end

# Regenerate Repocast.xcodeproj and the merged Info.plist from project.yml.
def regenerate_project
  Dir.chdir(PROJECT_ROOT) { sh("xcodegen generate") }
end

# Resolve an App Store Connect API key from environment variables. Returns
# the hash that build_app / upload_to_testflight expect, or nil if not set.
#
# Required env vars (see RELEASING.md):
#   ASC_KEY_ID         — the 10-char key ID from App Store Connect
#   ASC_ISSUER_ID      — the issuer UUID for the key
#   ASC_KEY_FILEPATH   — path to the .p8 file (alternative: ASC_KEY_CONTENT)
def resolve_asc_api_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_FILEPATH"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "true",
    duration: 1200,
    in_house: false
  )
end

# ─── Lanes ──────────────────────────────────────────────────────────────────

platform :ios do

  desc "Run unit and UI tests on a simulator (TEST_DEVICE overrides the default)."
  lane :tests do
    run_tests(
      project: XCODEPROJ,
      scheme: APP_SCHEME,
      # Pinned to an iOS 26 simulator: the iOS 27 ones fail test suites with
      # spurious "No eligible connection available" errors.
      devices: [ENV["TEST_DEVICE"] || "iPhone 17 Pro (26.5)"],
      clean: true
    )
  end

  desc "Increment the build number (CURRENT_PROJECT_VERSION) by 1, then regenerate the project."
  lane :bump_build do
    current = current_build_number.to_i
    new_build = current + 1
    write_versions(build: new_build.to_s)
    regenerate_project
    UI.success("Build number bumped: #{current} → #{new_build}")
  end

  desc "Set the marketing version explicitly and reset build to 1. Usage: fastlane set_version version:1.3"
  lane :set_version do |options|
    new_marketing = options[:version]
    UI.user_error!("Pass version:X.Y[.Z] — e.g. fastlane set_version version:1.3") if new_marketing.to_s.empty?
    old_marketing = current_marketing_version
    write_versions(marketing: new_marketing, build: "1")
    regenerate_project
    UI.success("Version set: #{old_marketing} → #{new_marketing} (build reset to 1)")
  end

  desc "Build a Release archive and upload it to TestFlight. Does not bump the version — chain with bump_build or set_version first."
  lane :beta do
    api_key = resolve_asc_api_key
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_FILEPATH (or ASC_KEY_CONTENT). See RELEASING.md.") if api_key.nil?

    # xcodebuild must be handed the ASC API key explicitly — gym does not
    # forward the lane's api_key to -exportArchive, and without it
    # -allowProvisioningUpdates falls back to Xcode's saved Apple ID session,
    # which fails with "No Accounts" whenever that token has expired.
    key_path = File.expand_path(ENV["ASC_KEY_FILEPATH"])
    auth_args = "-authenticationKeyPath #{key_path.shellescape} " \
                "-authenticationKeyID #{ENV['ASC_KEY_ID'].shellescape} " \
                "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID'].shellescape}"

    build_app(
      project: XCODEPROJ,
      scheme: APP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Repocast.ipa",
      # Manual signing at export: automatic signing insists on managing the
      # Xcode "Team Store" profile in the cloud, which needs an ASC key with
      # cloud-signing permission this key doesn't have. The named profile is
      # created/refreshed with `fastlane run sigh provisioning_name:"Repocast AppStore"`
      # whenever the distribution certificate or an App ID capability (e.g.
      # CarPlay) changes.
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { "au.com.bclgapps.Repocast" => "Repocast AppStore" }
      },
      # gym appends xcargs to BOTH the archive and the export invocations, so
      # the auth flags go here once — export_xcargs would duplicate them and
      # xcodebuild rejects a repeated -authenticationKeyPath.
      xcargs: "-allowProvisioningUpdates #{auth_args}"
    )

    begin
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    rescue StandardError => e
      # altool regularly logs "UPLOAD SUCCEEDED" and then a stray
      # CDUploaderStateInfoResumeFilePath "file doesn't exist" line on stderr,
      # which pilot reports as "Error uploading ipa file". Only App Store
      # Connect can say whether the build really landed, so ask it — and fail
      # as before if the build never appears.
      raise unless e.message.include?("Error uploading")

      UI.important("Upload reported an error — checking App Store Connect for #{current_marketing_version} (#{current_build_number}) before failing.")
      raise unless wait_for_build_on_testflight(api_key)

      UI.important("The build is on App Store Connect, so the upload succeeded; ignoring the uploader's error output.")
    end

    UI.success("Uploaded Repocast #{current_marketing_version} (#{current_build_number}) to TestFlight.")
    testflight_notes
  end

  desc "Set a build's TestFlight \"What to Test\" from fastlane/release-notes/<version>-<build>.txt."
  desc "Defaults to the current version and build. Usage: fastlane testflight_notes [build:10]"
  lane :testflight_notes do |options|
    build = (options[:build] || current_build_number).to_s
    path = release_notes_path(current_marketing_version, build)
    unless File.exist?(path)
      UI.important("No #{File.basename(path)} — leaving \"What to Test\" empty. Run `fastlane release_notes` to draft one.")
      next
    end

    api_key = resolve_asc_api_key
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_FILEPATH (or ASC_KEY_CONTENT). See RELEASING.md.") if api_key.nil?
    UI.user_error!("Build #{build} never appeared on App Store Connect.") unless wait_for_build_record(build)

    # distribute_only + skip_submission: no upload, no tester distribution —
    # it only writes the build's localized "What to Test".
    upload_to_testflight(
      api_key: api_key,
      distribute_only: true,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: current_marketing_version,
      build_number: build,
      changelog: File.read(path).strip,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
    UI.success("Set \"What to Test\" for #{current_marketing_version} (#{build}).")
  end

  desc "List the app's TestFlight beta groups and whether each one already gets every build."
  lane :beta_groups do
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_FILEPATH (or ASC_KEY_CONTENT). See RELEASING.md.") if resolve_asc_api_key.nil?

    Spaceship::ConnectAPI::App.find(APP_IDENTIFIER).get_beta_groups.each do |group|
      kind = group.is_internal_group ? "internal" : "external"
      access = group.has_access_to_all_builds ? ", gets every build automatically" : ""
      UI.message("#{group.name} (#{kind}#{access})")
    end
  end

  desc "Add a TestFlight build to beta groups once it has processed. Usage: fastlane distribute groups:<name>[,<name>] [build:12] (`fastlane beta_groups` lists the names)"
  desc "Groups that already get every build are skipped. An external group submits the build for Beta App Review and notifies its testers."
  lane :distribute do |options|
    build = (options[:build] || current_build_number).to_s
    names = options[:groups].to_s.split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Pass groups:<name>[,<name>] — `fastlane beta_groups` lists them.") if names.empty?

    api_key = resolve_asc_api_key
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_FILEPATH (or ASC_KEY_CONTENT). See RELEASING.md.") if api_key.nil?

    groups = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER).get_beta_groups
    unknown = names - groups.map(&:name)
    UI.user_error!("No beta group named #{unknown.join(', ')} — `fastlane beta_groups` lists them.") unless unknown.empty?

    # A group with access to every build can't have builds added to it, and
    # doesn't need them: App Store Connect already hands it each new one.
    automatic, manual = groups.select { |group| names.include?(group.name) }.partition(&:has_access_to_all_builds)
    automatic.each { |group| UI.message("#{group.name} already gets every build — nothing to add.") }
    next if manual.empty?

    UI.user_error!("Build #{build} didn't finish processing on App Store Connect.") unless wait_for_build_processed(build)

    external = manual.any? { |group| !group.is_internal_group }
    notes = release_notes_path(current_marketing_version, build)
    upload_to_testflight(
      api_key: api_key,
      distribute_only: true,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: current_marketing_version,
      build_number: build,
      groups: manual.map(&:name),
      # External testers only see a build once Beta App Review approves it,
      # and that review needs "What to Test" — so resend the notes with it.
      distribute_external: external,
      submit_beta_review: external,
      notify_external_testers: external,
      changelog: File.exist?(notes) ? File.read(notes).strip : nil
    )
    UI.success("Added #{current_marketing_version} (#{build}) to #{manual.map(&:name).join(', ')}.")
  end

  desc "Draft fastlane/release-notes/<version>-<build>.txt from the commits since the last build (its tag, or its build-number bump)."
  desc "Edit the draft before shipping — commit subjects are written for engineers, not testers."
  lane :release_notes do |options|
    path = release_notes_path(current_marketing_version, (options[:build] || current_build_number).to_s)
    UI.user_error!("#{File.basename(path)} already exists — edit it or delete it first.") if File.exist?(path)

    FileUtils.mkdir_p(NOTES_DIR)
    File.write(path, draft_release_notes + "\n")
    UI.success("Drafted #{path.delete_prefix(PROJECT_ROOT + '/')} from commits since #{last_build_ref || 'the start of history'}.")
  end

  desc "Tag the current build `Repocast-v<version>(<build>)` and push the tag."
  lane :tag_build do
    tag = build_tag
    if git_tag_exists(tag: tag)
      UI.important("#{tag} already exists — not moving it.")
    else
      add_git_tag(tag: tag)
    end
    push_git_tags(tag: tag)
  end

  desc "One shot: bump the build, upload it with its notes, then commit, tag and push."
  desc "Notes come from fastlane/release-notes/<version>-<next build>.txt; if it's missing a draft is generated from commits."
  lane :release_build do
    ensure_git_status_clean
    bump_build
    notes = release_notes_path
    release_notes unless File.exist?(notes)
    # Upload before committing: a failed archive leaves only a local bump to
    # retry with `fastlane beta`, never a pushed build number with no build.
    beta
    git_add(path: [PROJECT_YML, notes])
    git_commit(path: [PROJECT_YML, notes], message: "chore: bump build number to #{current_marketing_version} (#{current_build_number})")
    push_to_git_remote
    tag_build
  end

end
