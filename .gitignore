# Xcode project is generated by xcodegen from project.yml — never commit it.
Repocast.xcodeproj/

# Scratch dir for fastlane build artefacts (.ipa, .xcarchive, .dSYM).
build/

# macOS Finder metadata.
.DS_Store

# DerivedData / SwiftPM caches.
DerivedData/
.swiftpm/

# fastlane — keep Fastfile/Appfile/.env.example, ignore generated artefacts.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/.env*
!fastlane/.env.example

# Secrets — never commit App Store Connect keys, signing certs, or the
# Firebase config (it identifies your Firebase project).
*.p8
*.p12
*.ipa
*.dSYM.zip
GoogleService-Info.plist

# Bundler — keep Gemfile and Gemfile.lock, ignore installed gems.
.bundle/
vendor/bundle/

# swift-project-assistant generated summaries (<name>.md siblings of sources).
Sources/**/*.md

# Design-system source archive (extracted into .claude/skills/repocast-design/)
Repocast Design System.zip

# Local agent-tool caches (serena MCP project data, token-usage scratch).
.serena/
.tokensave/
