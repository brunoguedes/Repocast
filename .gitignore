# Xcode project is generated by xcodegen from project.yml — never commit it.
Repocast.xcodeproj/

# Scratch dir for fastlane build artefacts (.ipa, .xcarchive, .dSYM) and
# Tools/screenshots.sh intermediates.
build/

# macOS Finder metadata.
.DS_Store

# DerivedData / SwiftPM caches.
DerivedData/
.swiftpm/

# fastlane — keep Fastfile/Appfile/.env.example, ignore generated artefacts.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md
fastlane/.env*
!fastlane/.env.example

# Secrets — never commit App Store Connect API keys or signing certs.
*.p8
*.p12
*.ipa
*.dSYM.zip

# Firebase config — identifies the Firebase project; dropped in locally, never committed.
GoogleService-Info.plist

# Bundler — keep Gemfile and Gemfile.lock in version control, ignore installed gems.
.bundle/
vendor/bundle/

# Local agent/tooling state — machine-specific caches, indexes and databases.
.serena/
.orca/
.tokensave/

# Signing artifacts dropped by `fastlane run cert` / `run sigh` — regenerable, never committed
*.cer
*.certSigningRequest
*.mobileprovision

# snapshot intermediates — the lane copies the keepers into appstore/screenshots-*/
fastlane/screenshots/

# swift-project-assistant generated summaries (<name>.md siblings of sources).
Sources/**/*.md

# Design-system source archive (extracted into .claude/skills/repocast-design/)
Repocast Design System.zip
