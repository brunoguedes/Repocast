# Repo-wide ignores. App-specific rules (fastlane, Sources, bundler) live in
# ios/.gitignore; backend rules in backend/.gitignore.

# Xcode project is generated by xcodegen from ios/project.yml — never commit it.
Repocast.xcodeproj/

# Scratch dir for fastlane build artefacts (.ipa, .xcarchive, .dSYM).
build/

# macOS Finder metadata.
.DS_Store

# DerivedData / SwiftPM caches.
DerivedData/
.swiftpm/

# Secrets — never commit App Store Connect API keys or signing certs.
*.p8
*.p12
*.ipa
*.dSYM.zip

# Firebase config — identifies the Firebase project; dropped in locally, never committed.
GoogleService-Info.plist

# Bundler — keep Gemfile and Gemfile.lock in version control, ignore installed gems.
.bundle/

# Local agent/tooling state — machine-specific caches, indexes and databases.
.serena/
.orca/
.tokensave/

# Signing artifacts dropped by `fastlane run cert` / `run sigh` — regenerable, never committed
*.cer
*.certSigningRequest
*.mobileprovision

# Node / SST (backend/).
node_modules/
.sst/
.env
.env.*
!.env.example

# Design-system source archive (extracted into .claude/skills/repocast-design/)
Repocast Design System.zip
